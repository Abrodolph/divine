# Playground: your own test copy of Gridwatch with its own database.
# 1. Create a SEPARATE Supabase project (never the live one).
# 2. Copy this file to .env.playground and fill in that project's values
#    (Supabase → Project Settings → API).
# 3. npm run dev:playground  →  http://localhost:5174
VITE_APP_ENV=playground
VITE_PLAYGROUND_SUPABASE_URL=https://YOUR-PLAYGROUND-PROJECT.supabase.co
VITE_PLAYGROUND_SUPABASE_ANON_KEY=your-playground-anon-key
